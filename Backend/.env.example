# Server
NODE_ENV=development
PORT=5000

# Frontend URL (allowed CORS origin, no trailing slash)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# Reverse Proxy Trust (1 for Cloudflare/Nginx single proxy, 0 for direct)
TRUST_PROXY=1

# Admin Security & Authentication
ADMIN_API_KEY=your-secure-random-admin-key-here
ADMIN_EMAIL=admin@gaurav.dev
ADMIN_PASSWORD=your-secure-admin-password
JWT_SECRET=your-cryptographic-jwt-secret-minimum-32-chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_CONTACT_WINDOW_MS=900000
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5

# Email Delivery Option 1: Resend HTTPS REST API (Recommended for Cloud / Render)
RESEND_API_KEY=re_your_resend_api_key_here

# Email Delivery Option 2: Gmail SMTP (Local Development / VPS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
CONTACT_RECEIVER_EMAIL=your-email@gmail.com

