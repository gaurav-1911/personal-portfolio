# Frontend environment variables (copy to .env for local use)
#
# VITE_SITE_URL — canonical production URL used to generate robots.txt and
# sitemap.xml at build time. REQUIRED for production builds; without it the
# build falls back to http://localhost:5173 and emits a warning.
#
# Example:
#   VITE_SITE_URL=https://your-domain.com
VITE_SITE_URL=
