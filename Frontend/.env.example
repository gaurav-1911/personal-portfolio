# Frontend environment variables (copy to .env for local development)
#
# VITE_API_URL — base API URL (e.g., https://personal-portfolio-backend-cyym.onrender.com/api/v1 for production or /api/v1 for dev proxy)
VITE_API_URL=https://personal-portfolio-backend-cyym.onrender.com/api/v1

# VITE_SITE_URL — canonical production URL used to generate robots.txt and
# sitemap.xml at build time.
VITE_SITE_URL=https://gaurav-1911.github.io/personal-portfolio

